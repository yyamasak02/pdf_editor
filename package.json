{
  "name": "pdf_editor",
  "version": "1.0.0",
  "description": "ブラウザだけで動くPDF編集ツールです。サーバーへのアップロードは一切行わず、すべての処理はお使いのブラウザ内(JavaScript)で完結します。",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "test:cli": "node build.mjs && node --test tests/cli.test.mjs",
    "test:e2e": "node build.mjs && node --test tests/e2e.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "check:spec": "node scripts/check-spec.mjs",
    "check:secrets": "scripts/check-secrets.sh"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@expo-google-fonts/noto-sans-jp": "^0.4.4",
    "@types/fabric": "^5.3.11",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "fabric": "^5.3.0",
    "pdfjs-dist": "^2.16.105"
  }
}
